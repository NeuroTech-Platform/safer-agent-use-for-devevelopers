// Claude Code safety settings. See README.md.
// Claude Code reads strict JSON only. Install without the comment lines:
//   grep -v '^[[:space:]]*//' settings.jsonc > ~/.claude/settings.json
{
  // Lets your editor check the keys. The schema is behind Claude Code:
  // if your editor flags "blockReadsOutsideWorkingDirectories", keep it.
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    // Start in auto mode: a classifier approves routine actions and blocks risky ones.
    "defaultMode": "auto",
    // Refuse bypass mode (--dangerously-skip-permissions): no prompts, no safety checks.
    "disableBypassPermissionsMode": "disable",
    // Claude's file tools read only the project. Shell commands can't read
    // home folders or mounted drives, except the project.
    "blockReadsOutsideWorkingDirectories": true,

    "deny": [
      // Block reads of SSH keys and AWS credentials.
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      // Block reads of .env files in the project. .env.example stays readable.
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      // Claude can't change its own settings: yours, ~/.claude.json (folder trust,
      // MCP servers), a project's, or SandVault's copy and login token.
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude.json)",
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/settings.local.json)",
      "Edit(//Users/Shared/sv-*/user/**)",
      // Claude can't change your personal instructions, which load in every session.
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/rules/**)",
      // Claude can't change sv-claude, which runs as you: its source, anything in
      // ~/.local/bin, which is on your PATH, and its records of each session.
      "Edit(**/bin/sv-claude)",
      "Edit(~/.local/bin/**)",
      "Edit(~/Library/Caches/sv-claude/**)"
    ],
    "ask": [
      // Ask before any command runs outside the sandbox, in every mode.
      "Bash(dangerouslyDisableSandbox:true)",
      // Ask before docker commands that run code: in a container, or while building an image.
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker build *)",
      "Bash(docker buildx build *)",
      "Bash(docker compose *)",
      // Ask before commands that run code in a cluster, or change one. Reads, such as
      // kubectl get and helm list, don't ask.
      "Bash(kubectl apply *)",
      "Bash(kubectl create *)",
      "Bash(kubectl run *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl delete *)",
      "Bash(helm install *)",
      "Bash(helm upgrade *)",
      "Bash(helm uninstall *)",
      "Bash(kind create *)",
      "Bash(kind delete *)",
      "Bash(ct install *)",
      "Bash(cilium install *)",
      // Ask before every gh command: it runs outside the sandbox, with your GitHub login.
      "Bash(gh *)"
    ],
    "allow": [
      // Read-only docker commands run without asking.
      "Bash(docker ps *)",
      "Bash(docker logs *)"
    ]
  },

  "sandbox": {
    // Run shell commands in the OS sandbox: Seatbelt on macOS, bubblewrap on Linux and WSL2.
    "enabled": true,
    // If the sandbox can't start, Claude Code exits instead of running commands unsandboxed.
    // On native Windows it always exits: use WSL2.
    "failIfUnavailable": true,
    // Claude may retry a blocked command outside the sandbox. The ask rule above
    // makes you approve each retry.
    "allowUnsandboxedCommands": true,
    // These run outside the sandbox, with your full access. docker needs its daemon's
    // socket and its config in your home folder, which the sandbox hides. gh can't
    // read its login there, and the Kubernetes tools can't read ~/.kube/config.
    // The ask rules above cover the risky calls; auto mode reviews the others.
    "excludedCommands": ["docker *", "gh *", "kind *", "kubectl *", "helm *", "ct *", "cilium *"],

    "filesystem": {
      // npm keeps its cache in your home folder, which the read block hides.
      // Without these, npm install fails in the sandbox.
      "allowRead": ["~/.npm"],
      "allowWrite": ["~/.npm"]
    },

    "network": {
      // The only hosts shell commands can reach. Every allowed host can receive data;
      // keep the list short.
      "allowedDomains": [
        // Source control
        "github.com",
        "*.github.com",
        "githubusercontent.com",
        "*.githubusercontent.com",

        // Hugging Face and Xet storage
        "huggingface.co",
        "us.aws.cdn.hf.co",
        "us.gcp.cdn.hf.co",
        "cdn-lfs-us-1.hf.co",
        "cdn-lfs-eu-1.hf.co",
        "cas-bridge.xethub.hf.co",
        "cas-server.xethub.hf.co",
        "transfer.xethub.hf.co",

        // JavaScript
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "nodejs.org",

        // Python
        "pypi.org",
        "files.pythonhosted.org",

        // GPU and ML
        "developer.download.nvidia.com",
        "edge.urm.nvidia.com",
        "pypi.nvidia.com",
        "download.pytorch.org",
        "download-r2.pytorch.org",
        "www.gstatic.com",

        // Linux distributions
        "dl-cdn.alpinelinux.org",
        "deb.debian.org",
        "security.debian.org",
        "archive.ubuntu.com",
        "security.ubuntu.com",
        "ports.ubuntu.com",
        "download.fedoraproject.org",
        "mirrors.fedoraproject.org",
        "dl.rockylinux.org",
        "repo.almalinux.org",
        "mirrorlist.centos.org",
        "mirror.stream.centos.org",
        "download.opensuse.org",
        "mirror.archlinux.org",
        "geo.mirror.pkgbuild.com",

        // Containers: pull paths only
        "registry-1.docker.io",
        "auth.docker.io",
        "production.cloudflare.docker.com",
        "ghcr.io",
        "quay.io",
        "mcr.microsoft.com",
        "gcr.io",
        "nvcr.io",

        // Rust
        "static.rust-lang.org",
        "crates.io",
        "index.crates.io",
        "static.crates.io",

        // Go
        "go.dev",
        "dl.google.com",
        "proxy.golang.org",
        "sum.golang.org",

        // Java and Kotlin
        "repo.maven.apache.org",
        "repo1.maven.org",
        "plugins.gradle.org",
        "services.gradle.org",
        "downloads.gradle.org",

        // Ruby
        "rubygems.org",
        "index.rubygems.org",

        // PHP
        "packagist.org",
        "repo.packagist.org",
        "getcomposer.org",

        // .NET
        "api.nuget.org",
        "globalcdn.nuget.org",

        // Haskell, Swift, Perl and R
        "hackage.haskell.org",
        "downloads.haskell.org",
        "download.swift.org",
        "cpan.org",
        "www.cpan.org",
        "cran.r-project.org",

        // Language documentation
        "docs.python.org",
        "developer.mozilla.org",
        "doc.rust-lang.org",
        "docs.rs",
        "pkg.go.dev",
        "docs.oracle.com",
        "docs.gradle.org",
        "kotlinlang.org",
        "docs.ruby-lang.org",
        "www.php.net",
        "learn.microsoft.com",
        "docs.swift.org"
      ],
      // Refuse all other hosts without asking. Repository settings can't add hosts.
      "strictAllowlist": true
    },

    "credentials": {
      // Remove these secrets from the environment of sandboxed commands.
      "envVars": [
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "CLAUDE_CODE_OAUTH_TOKEN", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" }
      ]
    }
  },

  "env": {
    // Turn off usage metrics and session surveys. This also turns off feature flags,
    // so Remote Control and a few extras stop working. Updates stay on.
    "DISABLE_TELEMETRY": "1",
    // Turn off error reports.
    "DISABLE_ERROR_REPORTING": "1",
    // Turn off /feedback, /bug and /share, which upload the conversation, including code.
    "DISABLE_FEEDBACK_COMMAND": "1"
  },

  // Start every session on Opus 5.5 at high effort. Fable models can bill usage credits.
  // In SandVault, a /model or /effort change lasts one session: SandVault restores this file at every start.
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-opus-5-5": { "effortLevel": "high" }
  },

  // Show each tool call in full, so you see what Claude does.
  "viewMode": "verbose",
  // Show summaries of Claude's reasoning.
  "showThinkingSummaries": true,
  // Don't connect to Remote Control (driving this session from claude.ai or the mobile app) at startup.
  "remoteControlAtStartup": false
}
